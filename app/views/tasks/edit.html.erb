<h1>Edit task</h1>

<%= form_with model: @task do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :details %>
    <%= form.text_area :details %>
  </div>

  <div>
    <%= form.check_box :completed %>
    <%= form.label :completed %>
  </div>

  <div>
    <%= form.submit "Update task" %>
  </div>
<% end %>

<%= link_to "Back to tasks", tasks_path %>
