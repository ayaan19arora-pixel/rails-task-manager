<h1>Tasks</h1>

<%= link_to "New task", new_task_path %>

<% @tasks.each do |task| %>
  <div>
    <h2><%= link_to task.title, task_path(task) %></h2>
    <p><%= task.details %></p>
    <%= link_to "Edit", edit_task_path(task) %>
    <%= button_to "Delete", task_path(task), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
  </div>
<% end %>
